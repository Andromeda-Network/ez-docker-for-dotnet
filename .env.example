# ============================================
# EZ Docker For .NET - shared service versions
# ============================================
# `ez shared deploy` writes these into docker/docker.env with the values below; this file is the
# reference. Change them there, then: ./ez shared deploy (it pulls and recreates what changed).
#
# Update deliberately: try a new version on a test server first, then note it in the commit.

# Nginx Proxy Manager - reverse proxy with Let's Encrypt
NGINX_PM_VERSION=2.11.1

# SQL Server (DB_ENGINE=mssql). 2022-latest follows cumulative updates; for production pin a CU,
# e.g. 2022-CU15-ubuntu-22.04 (https://mcr.microsoft.com/product/mssql/server/tags).
MSSQL_VERSION=2022-latest
# Express: free, licensed for production, 10 GB per database. Developer: not for production.
MSSQL_PID=Express

# PostgreSQL (DB_ENGINE=postgres)
POSTGRES_VERSION=17.2-alpine

# Redis - caches, sessions, distributed locks
REDIS_VERSION=7.4.1-alpine

# Seq - structured logs and errors from every app (SHARED_PROFILES=seq)
SEQ_VERSION=2024.3

# Portainer - container management UI (SHARED_PROFILES=portainer)
PORTAINER_VERSION=2.19.4

# .NET apps choose their own SDK/runtime with DOTNET_VERSION in apps/<app>/env/app.env
# (8.0, 9.0 or 10.0), which template/dotnet.Dockerfile builds on.
