# src/lib/merge_app_envs.sh
merge_app_envs() {
  local app_dir=$1
  local app_env=$2

  docker_env_path="docker/docker.env"
  app_env_path="$app_dir/env/app.env"
  override_env_path="$app_dir/env/$app_env.env"
  merged_env_path="$app_dir/env/generated/$app_env.env"

  mkdir -p "$app_dir/env/generated"
  merge_envs "$merged_env_path" "$docker_env_path" "$app_env_path" "$override_env_path"
  # The merged file is the app's environment (env_file) and holds its secrets.
  chmod 600 "$merged_env_path"

  echo "$merged_env_path"
}

# src/lib/merge_envs.sh
merge_envs() {
  if [ "$#" -lt 3 ]; then
    log_error "Usage: merge_env <output> <file1> <file2> [file3 ... fileN]"
    exit 1
  fi

  local output="$1"
  shift

  local merged_content=""

  for file in "$@"; do
    if [ ! -e "$file" ]; then
      log_error "$file does not exist!"
      exit 1
    fi

    # Sort, filter, and remove duplicates from merged content
    merged_content=$(sort -u -t '=' -k 1,1 "$file" <(printf "%s" "$merged_content") | grep -v '^$\|^\s*\#')
  done

  # Mask host-side plumbing out of the app's .env. These configure ez itself — the registry it
  # pulls from, the database superuser, the source repo — and the application has no use for any
  # of them; REGISTRY_TOKEN especially has no business inside an app's environment.
  # TODO improve this part
  # The shared services' own superuser passwords (SQL Server sa, Postgres, Redis, Seq) are ez's,
  # not the app's: each app gets its own database login (create_new_database_and_user).
  merged_content=$(echo "$merged_content" | grep -Ev '^(SHARED_NETWORK_NAME|SHARED_PROFILES|DB_ROOT_PASSWORD|MSSQL_SA_PASSWORD|POSTGRES_PASSWORD|SEQ_ADMIN_PASSWORD|GIT_URL|REGISTRY_HOST|REGISTRY_USER|REGISTRY_TOKEN)=')

  echo "$merged_content" > "$output"
}

# src/lib/read_multi_line_input.sh
read_multi_line_input() {
    local delimiter=$1
    local result

    result=""
    while IFS= read -r line; do
        [[ $line == "$delimiter" ]] && break
        result+="$line"$'\n'
    done

    echo "$result"
}

# src/lib/registry_login.sh
# Log the host in to the image registry, when image mode needs one.
#
# A public registry needs no credentials, so an empty REGISTRY_TOKEN is a valid anonymous pull.
# A half-filled pair is a misconfiguration, and saying so here beats an opaque
# `pull access denied` further down.
registry_login() {
  local registry="$1" user="$2" token="$3"

  if [[ -z "$token" && -z "$user" ]]; then
    log_info "No registry credentials set — assuming an anonymous pull."
    return 0
  fi

  if [[ -z "$token" || -z "$user" ]]; then
    log_error "Registry credentials are half-set: REGISTRY_USER and REGISTRY_TOKEN must both be"
    log_error "present, or both empty for an anonymous pull."
    exit 1
  fi

  if [[ -z "$registry" ]]; then
    log_error "REGISTRY_USER/REGISTRY_TOKEN are set but REGISTRY_HOST is empty."
    log_error "Set REGISTRY_HOST in docker/docker.env (e.g. registry.example.com)."
    exit 1
  fi

  log_info "Logging in to $registry ..."
  if ! printf '%s' "$token" | docker login "$registry" --username "$user" --password-stdin; then
    log_error "docker login to $registry failed for user '$user'."
    log_error "Check REGISTRY_USER / REGISTRY_TOKEN and that the token carries read_registry."
    exit 1
  fi
}

# src/lib/setup_environment.sh
setup_environment() {
  local app_name=$1
  local environment=$2

  local branch_name db_database db_username generated_password db_password aspnet_env app_port connection

  if [ "$environment" == "production" ]; then
    branch_name="main"
  else
    branch_name="$environment"
  fi

  branch_name=$(ask_question "Enter the ${environment} branch name" "$branch_name")

  # SQL identifiers: the app name's '-' becomes '_'.
  db_database=$(ask_question "Enter the ${environment} database name" "${app_name//-/_}_${environment}")
  db_username=$(ask_question "Enter the ${environment} database username" "${app_name//-/_}_${environment}_user")
  generated_password=$(generate_password 24)
  db_password=$(ask_question "Enter the $db_username's password" "$generated_password")

  app_port=""
  case "$environment" in
    dev)        aspnet_env=Development; app_port=$(assign_port "dev" 7000) ;;
    test)       aspnet_env=Test;        app_port=$(assign_port "test" 8000) ;;
    staging)    aspnet_env=Staging ;;
    production) aspnet_env=Production ;;
  esac

  case "${DB_ENGINE:-mssql}" in
    postgres) connection="Host=postgres;Database=$db_database;Username=$db_username;Password=$db_password" ;;
    none)     connection="" ;;
    *)        connection="Server=mssql;Database=$db_database;User Id=$db_username;Password=$db_password;TrustServerCertificate=True;MultipleActiveResultSets=True" ;;
  esac

  cat <<EOL > "apps/$app_name/env/$environment.env"
GIT_BRANCH=$branch_name
APP_ENV=$environment
ASPNETCORE_ENVIRONMENT=$aspnet_env
APP_PORT=$app_port
DB_DATABASE=$db_database
DB_USERNAME=$db_username
DB_PASSWORD=$db_password
# The app's settings: .NET reads nested keys with __ (Section__Key).
ConnectionStrings__Default=$connection
ConnectionStrings__Redis=redis:6379,password=${REDIS_PASSWORD}
Seq__ServerUrl=http://seq:5341
EOL
  chmod 600 "apps/$app_name/env/$environment.env"

  log_info "created apps/$app_name/env/$environment.env"
}

# src/lib/shared_compose.sh
# docker compose for the shared services, with the optional ones in SHARED_PROFILES
# (docker/docker.env: e.g. "mssql seq") and the database in DB_ENGINE.
shared_compose() {
  local profiles=() p
  for p in ${DB_ENGINE:-mssql} ${SHARED_PROFILES:-}; do
    [[ "$p" == none ]] && continue
    profiles+=(--profile "$p")
  done
  docker compose -p ez-shared -f docker/compose-shared.yml --env-file docker/docker.env "${profiles[@]}" "$@"
}

# src/lib/update_source_code.sh
update_source_code() {
  log_info "updating source code ..."
  local source_code_dir="apps/${args[APP_NAME]}/src-${args[APP_ENV]}"
  local project_path="${source_code_dir}/${PROJECT}"

  if [ -d "$source_code_dir/.git" ]; then
      log "Updating existing $source_code_dir folder ($GIT_BRANCH)"
      # fetch + reset, not pull: the checkout is a build input, never edited on the server
      # (dev's is, and keeps pull so local edits are not thrown away).
      if [[ "${args[APP_ENV]}" == "dev" ]]; then
          git -C "$source_code_dir" pull origin "$GIT_BRANCH" || { log_error "Error: Git pull failed."; exit 1; }
      else
          git -C "$source_code_dir" fetch --depth 1 origin "$GIT_BRANCH" \
            && git -C "$source_code_dir" reset --hard "origin/$GIT_BRANCH" \
            || { log_error "Error: Git fetch failed."; exit 1; }
      fi
  else
      log "Cloning new $source_code_dir folder"
      git clone --depth 1 -b "$GIT_BRANCH" "$GIT_URL" "$source_code_dir" || { log_error "Error: Git cloning failed."; exit 1; }
  fi

  # The build context is the repository root; keep bin/obj, .git and env files out of it.
  if [ ! -f "$source_code_dir/.dockerignore" ]; then
      cp "apps/${args[APP_NAME]}/.dockerignore" "$source_code_dir/.dockerignore"
  fi

  if [ ! -f "$project_path" ]; then
      log_error "Error: project not found at $project_path"
      log_error "PROJECT is set to: '${PROJECT}' in apps/${args[APP_NAME]}/env/app.env"
      exit 1
  fi

  log_success "Project found at: $project_path"
}

