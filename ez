# :command.normalize_input
# :command.normalize_input_function
normalize_input() {
  local arg passthru flags
  passthru=false

  while [[ $# -gt 0 ]]; do
    arg="$1"
    if [[ $passthru == true ]]; then
      input+=("$arg")
    elif [[ $arg =~ ^(--[a-zA-Z0-9_\-]+)=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^(-[a-zA-Z0-9])=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^-([a-zA-Z0-9][a-zA-Z0-9]+)$ ]]; then
      flags="${BASH_REMATCH[1]}"
      for ((i = 0; i < ${#flags}; i++)); do
        input+=("-${flags:i:1}")
      done
    elif [[ "$arg" == "--" ]]; then
      passthru=true
      input+=("$arg")
    else
      input+=("$arg")
    fi

    shift
  done
}

# :command.inspect_args
inspect_args() {
  local k

  if ((${#args[@]})); then
    readarray -t sorted_keys < <(printf '%s\n' "${!args[@]}" | sort)
    echo args:
    for k in "${sorted_keys[@]}"; do
      echo "- \${args[$k]} = ${args[$k]}"
    done
  else
    echo args: none
  fi

  if ((${#deps[@]})); then
    readarray -t sorted_keys < <(printf '%s\n' "${!deps[@]}" | sort)
    echo
    echo deps:
    for k in "${sorted_keys[@]}"; do
      echo "- \${deps[$k]} = ${deps[$k]}"
    done
  fi

  if ((${#env_var_names[@]})); then
    readarray -t sorted_names < <(printf '%s\n' "${env_var_names[@]}" | sort)
    echo
    echo "environment variables:"
    for k in "${sorted_names[@]}"; do
      echo "- \$$k = ${!k:-}"
    done
  fi
}

# :command.user_lib
# src/lib/ask_question.sh
ask_question() {
    local question=$1
    local default=$2
    local result

    local GREEN='\033[0;32m'
    local YELLOW='\033[0;33m'
    local NC='\033[0m' # No Color

    # Prompt the user with the question and default answer
    read -p "$(echo -e "${GREEN}$question ${YELLOW}[$default]${NC}: ")" result

    # Use the default if the user presses Enter without typing anything
    if [[ -z "$result" ]]; then
        result=$default
    fi

    echo $result
}

# src/lib/ask_question_v2.sh
#TODO This is WIP, read, echo does not work
ask_question_v2() {
    local question=$1
    local default=$2
    local regex=$3
    local required=$4
    local hide_text=$5

    local result

    local GREEN='\033[0;32m'
    local YELLOW='\033[0;33m'
    local RED='\033[0;31m'
    local NC='\033[0m' # No Color

    while true; do
        # Prompt the user with the question and default answer
        if [ "$hide_text" == "true" ]; then
            read -s -p "$(echo -e "${GREEN}$question ${YELLOW}[$default]${NC}: ")" result
            echo ""  # Move to a new line after hidden input
        else
            read -p "$(echo -e "${GREEN}$question ${YELLOW}[$default]${NC}: ")" result
        fi

        # Use the default if the user presses Enter without typing anything
        if [[ -z "$result" ]]; then
            result=$default
        fi

        # Check if the result is required
        if [ "$required" == "true" ] && [[ -z "$result" ]]; then
            echo -e "${RED}This field is required.${NC}"
            continue
        fi

        # Check if the result matches the regex
        if [ -n "$regex" ] && ! [[ "$result" =~ $regex ]]; then
            echo -e "${RED}Invalid input format, should match regex: '$regex'${NC}"
            continue
        fi

        break
    done

    echo $result
}

# src/lib/assign_port.sh
assign_port() {
  local environment=$1
  local base_port=$2
  local num_apps default_port app_port

  num_apps=$(find apps -mindepth 1 -maxdepth 1 -type d | wc -l)
  default_port=$((base_port + num_apps))

  while true; do
    app_port=$(ask_question "Enter the ${environment} app port" "$default_port")

    if is_port_in_use "$app_port"; then
      log_error "Port $app_port is already in use. Please choose a different port." >&2
    else
      echo "$app_port"  # This should be captured in the main script
      return 0
    fi
  done
}

# src/lib/check_containers.sh
check_containers() {
    log_header "Checking shared containers health before deploying the app."
    local containers=("$@")
    local retries=4
    local delay=10
    # Local: the callers have variables of these names (dotnet deploy's $container).
    local container attempt i

    for container in "${containers[@]}"; do
        for attempt in $(seq 1 $((retries + 1))); do
            if is_container_running "$container"; then
                log_success "Container '$container' is running."
                if is_container_healthy "$container"; then
                    log_success "Container '$container' is healthy."
                    break
                else
                    log_warning "Container '$container' is not healthy. Attempt $((attempt))/$retries."
                fi
            else
                log_warning "Container '$container' is not running. Attempt $((attempt))/$retries. You can run shared container by './ez shared deploy'"
            fi

            if [ $attempt -gt $retries ]; then
                log_error "Container '$container' is not healthy or not running after $retries attempts."
                #fixme
                #exit 1
            fi

            log_info "Retrying in $delay seconds: "
            for ((i=0; i<$delay; i++)); do
                echo -n "."
                sleep 1
            done
            echo ""
        done
    done
}

# src/lib/create_new_database_and_user.sh
# Create the app environment's database and its own login on the shared database server
# (DB_ENGINE in docker/docker.env: mssql, postgres, or none to skip). Idempotent: an existing
# database is kept, an existing login gets the password from the env file again.
#
# Names reach SQL as identifiers, so they are validated first (letters, digits, _ only).
# Passwords travel as environment variables: `docker exec -e NAME` (no value) copies NAME from
# this process's environment, so no password appears on a command line (`ps`), host or container.
create_new_database_and_user() {

  if [ "$#" -ne 3 ]; then
      log_error "Invalid Arguments, Usage: $0 <new_db_name> <new_user_name> <new_user_password>"
      return 1
  fi

  local db_name=$1 user_name=$2 user_password=$3
  local engine="${DB_ENGINE:-mssql}"

  if [[ "$engine" == "none" ]]; then
    log_info "DB_ENGINE=none: not creating a database."
    return 0
  fi

  if [[ ! "$db_name" =~ ^[A-Za-z_][A-Za-z0-9_]{0,63}$ || ! "$user_name" =~ ^[A-Za-z_][A-Za-z0-9_]{0,63}$ ]]; then
    log_error "Database and user names must be letters, digits and _ (got '$db_name', '$user_name')."
    exit 1
  fi
  if [[ -z "$user_password" || "$user_password" == *"'"* || "$user_password" == *"]"* ]]; then
    log_error "DB_PASSWORD for $user_name must be set and must not contain ' or ]."
    exit 1
  fi

  log_header "Creating Database: $db_name with User: $user_name ($engine)"

  case "$engine" in
    mssql)
      # sqlcmd reads $(DB), $(USR) and $(PWD_) from its environment, and the sa password from
      # SQLCMDPASSWORD.
      if ! SQLCMDPASSWORD="$MSSQL_SA_PASSWORD" DB="$db_name" USR="$user_name" PWD_="$user_password" \
          docker exec -i -e SQLCMDPASSWORD -e DB -e USR -e PWD_ \
          mssql /opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -b <<'SQL'
IF DB_ID(N'$(DB)') IS NULL EXEC(N'CREATE DATABASE [$(DB)]');
IF SUSER_ID(N'$(USR)') IS NULL
    EXEC(N'CREATE LOGIN [$(USR)] WITH PASSWORD = N''$(PWD_)'', CHECK_POLICY = OFF, DEFAULT_DATABASE = [$(DB)]');
ELSE
    EXEC(N'ALTER LOGIN [$(USR)] WITH PASSWORD = N''$(PWD_)''');
EXEC(N'USE [$(DB)];
IF USER_ID(N''$(USR)'') IS NULL CREATE USER [$(USR)] FOR LOGIN [$(USR)];
ALTER ROLE db_owner ADD MEMBER [$(USR)];');
SQL
      then
        log_error "Failed to create database '$db_name' or login '$user_name' on mssql."
        exit 1
      fi
      ;;
    postgres)
      # The new role's password is a psql variable set from the script itself (\getenv), not argv.
      if ! PGPASSWORD="$POSTGRES_PASSWORD" EZ_DB="$db_name" EZ_USR="$user_name" EZ_PWD="$user_password" \
          docker exec -i -e PGPASSWORD -e EZ_DB -e EZ_USR -e EZ_PWD postgres \
          psql -v ON_ERROR_STOP=1 -U postgres <<'SQL'
\getenv db EZ_DB
\getenv usr EZ_USR
\getenv pwd EZ_PWD
SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', :'usr', :'pwd') WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = :'usr') \gexec
SELECT format('ALTER ROLE %I PASSWORD %L', :'usr', :'pwd') \gexec
SELECT format('CREATE DATABASE %I OWNER %I', :'db', :'usr') WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = :'db') \gexec
SQL
      then
        log_error "Failed to create database '$db_name' or role '$user_name' on postgres."
        exit 1
      fi
      ;;
    *)
      log_error "Unknown DB_ENGINE '$engine' (mssql, postgres or none)."
      exit 1
      ;;
  esac

  log_success "Database $db_name ready; $user_name owns it."
}

# src/lib/deploy_state.sh
# The image tag last deployed to an environment, so a failed deploy can roll back to it.
deployed_tag_file() { echo "apps/$1/env/generated/$2.deployed"; }

read_deployed_tag() { cat "$(deployed_tag_file "$1" "$2")" 2>/dev/null || true; }

record_deployed_tag() { echo "$3" > "$(deployed_tag_file "$1" "$2")"; }

# Wait for a container's health check (the app's /healthz). A container without a health check
# counts once it is running.
wait_for_healthy() {
  local container=$1 timeout=${2:-180} waited=0 state
  log_info "Waiting for $container to become healthy (up to ${timeout}s) ..."
  while (( waited < timeout )); do
    state=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container" 2>/dev/null || echo missing)
    case "$state" in
      healthy|running) return 0 ;;
      unhealthy|exited|dead) (( waited > 10 )) && return 1 ;;
    esac
    sleep 3
    waited=$((waited + 3))
  done
  return 1
}

# An image reference without its tag: registry.example.com:5000/group/app:v1 -> .../group/app
# (a ':' after the last '/' is the tag; a registry port before it stays).
image_name() {
  local image=$1
  if [[ "${image##*/}" == *:* ]]; then image=${image%:*}; fi
  echo "$image"
}

image_tag() {
  local image=$1
  if [[ "${image##*/}" == *:* ]]; then echo "${image##*:}"; else echo latest; fi
}

# src/lib/dotnet_compose.sh
# docker compose for one environment of one app. Each environment is its own compose project
# (<app>_<env>), so a command for test can never touch production's containers.
#
# Needs: app_dir, merged_env_path (merge_app_envs) and the loaded env (load_app_envs).
dotnet_compose() {
  local file="$app_dir/compose-dotnet.yml"
  if [[ "${DEPLOY_MODE:-build}" == "image" && "${args[APP_ENV]}" != "dev" && "${args[APP_ENV]}" != "test" ]]; then
    file="$app_dir/compose-dotnet-image.yml"
  fi
  local project
  project=$(echo "${args[APP_NAME]}_${args[APP_ENV]}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_\n-' '_')
  docker compose -p "$project" -f "$file" --profile "${args[APP_ENV]}" --env-file "$merged_env_path" "$@"
}

# The compose service and container of an environment.
dotnet_service() { echo "dotnet-${args[APP_ENV]}"; }
dotnet_container() { echo "${args[APP_NAME]}_${args[APP_ENV]}"; }

# Validate APP_NAME/APP_ENV, find the app, merge and load its environment.
prepare_app() {
  if ! validate_app_name "${args[APP_NAME]}"; then
    log_error "Invalid application name: ${args[APP_NAME]}"
    log_error "Application names must contain only letters, numbers, hyphens and underscores (64 at most)."
    exit 1
  fi
  if ! validate_environment "${args[APP_ENV]}"; then
    log_error "Invalid environment: ${args[APP_ENV]} (dev, test, staging or production)"
    exit 1
  fi

  app_dir="apps/${args[APP_NAME]}"
  if [[ ! -d "$app_dir" ]]; then
    log_error "Application directory not found: $app_dir"
    log_error "The application '${args[APP_NAME]}' has not been initialized. Create it first:"
    log_error "  ./ez dotnet new"
    exit 1
  fi
  if [[ ! -f "$app_dir/env/${args[APP_ENV]}.env" ]]; then
    log_error "No ${args[APP_ENV]} environment for ${args[APP_NAME]} ($app_dir/env/${args[APP_ENV]}.env)."
    exit 1
  fi

  merged_env_path=$(merge_app_envs "$app_dir" "${args[APP_ENV]}")
  load_app_envs "$app_dir" "${args[APP_ENV]}" >/dev/null
  DEPLOY_MODE="${DEPLOY_MODE:-build}"
  if [[ "$DEPLOY_MODE" != "build" && "$DEPLOY_MODE" != "image" ]]; then
    log_error "Invalid DEPLOY_MODE: '$DEPLOY_MODE' (expected 'build' or 'image') in $app_dir/env/app.env"
    exit 1
  fi
}

# src/lib/generate_password.sh
generate_password() {
    local length=$1
    local charset="A-Za-z0-9@%&*"
    tr -dc "$charset" </dev/urandom | head -c $length
}

