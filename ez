ez_dotnet_deploy_parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        ez_dotnet_deploy_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.command_filter
  action="dotnet deploy"

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      # :flag.case
      --tag | -t)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--tag']="$2"
          shift
          shift
        else
          printf "%s\n" "--tag requires an argument: --tag, -t TAG" >&2
          exit 1
        fi
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        # :argument.case
        if [[ -z ${args['APP_NAME']+x} ]]; then
          args['APP_NAME']=$1
          shift
        # :argument.case
        elif [[ -z ${args['APP_ENV']+x} ]]; then
          args['APP_ENV']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  # :command.required_args_filter
  if [[ -z ${args['APP_NAME']+x} ]]; then
    printf "missing required argument: APP_NAME\nusage: ez dotnet deploy APP_NAME APP_ENV [OPTIONS]\n" >&2

    exit 1
  fi

  if [[ -z ${args['APP_ENV']+x} ]]; then
    printf "missing required argument: APP_ENV\nusage: ez dotnet deploy APP_NAME APP_ENV [OPTIONS]\n" >&2

    exit 1
  fi

  # :command.whitelist_filter
  if [[ -n ${args['APP_ENV']:-} ]] && [[ ! ${args['APP_ENV']:-} =~ ^(dev|test|staging|production)$ ]]; then
    printf "%s\n" "APP_ENV must be one of: dev, test, staging, production" >&2
    exit 1
