# :command.user_hooks
before_hook() {
  # src/before.sh

  #inspect_args

  # Check Docker access instead of requiring root
  if ! docker ps >/dev/null 2>&1; then
     log_error "Cannot connect to Docker daemon

  This script requires access to Docker. Please ensure:
    1. Docker is installed and running
    2. Your user has permission to access Docker

  To add your user to the docker group:
    sudo usermod -aG docker \$USER
    newgrp docker

  Or run with sudo if you prefer:
    sudo ./ez <command>"
     exit 1
  fi
}

# :command.initialize
initialize() {
  declare -g version="0.4.0"
  set -e

}

# :command.run
run() {
  # :command.globals
  declare -g long_usage=''
  declare -g -A args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"
  before_hook

  case "$action" in
    "docker") ez_docker_command ;;
    "docker install") ez_docker_install_command ;;
    "docker uninstall") ez_docker_uninstall_command ;;
    "docker remove") ez_docker_remove_command ;;
    "shared") ez_shared_command ;;
    "shared deploy") ez_shared_deploy_command ;;
    "shared start") ez_shared_start_command ;;
    "shared stop") ez_shared_stop_command ;;
    "shared restart") ez_shared_restart_command ;;
    "shared down") ez_shared_down_command ;;
    "dotnet") ez_dotnet_command ;;
    "dotnet deploy") ez_dotnet_deploy_command ;;
    "dotnet start") ez_dotnet_start_command ;;
    "dotnet stop") ez_dotnet_stop_command ;;
    "dotnet restart") ez_dotnet_restart_command ;;
    "dotnet down") ez_dotnet_down_command ;;
    "dotnet logs") ez_dotnet_logs_command ;;
    "dotnet status") ez_dotnet_status_command ;;
    "dotnet migrate") ez_dotnet_migrate_command ;;
    "dotnet rollback") ez_dotnet_rollback_command ;;
    "dotnet new") ez_dotnet_new_command ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  # :command.start
  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
fi
